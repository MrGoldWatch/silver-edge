// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastLogin DateTime? @map("last_login")
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  hunts Hunt[]

  @@map("users")
}

model Hunt {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  bankName       String    @map("bank_name")
  branchName     String?   @map("branch_name")
  branchAddress  String?   @map("branch_address")
  branchNumber   String?   @map("branch_number")
  latitude       Float?
  longitude      Float?
  huntDate       DateTime  @map("hunt_date") @db.Date
  totalRolls     Int       @default(0) @map("total_rolls")
  totalCoinsChecked Int    @default(0) @map("total_coins_checked")
  totalSilverFound Int     @default(0) @map("total_silver_found")
  isProcessed    Boolean   @default(false) @map("is_processed")
  processingNotes String?  @map("processing_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  denominations HuntDenomination[]

  @@map("hunts")
}

model HuntDenomination {
  id                String   @id @default(cuid())
  huntId            String   @map("hunt_id")
  denomination      String   // 'Dimes', 'Quarters', 'Halves'
  numberOfRolls     Int      @map("number_of_rolls")
  coinsPerRoll      Int      @map("coins_per_roll")
  totalCoinsChecked Int      @map("total_coins_checked")
  silverCoinsFound  Int      @default(0) @map("silver_coins_found")
  isProcessed       Boolean  @default(false) @map("is_processed")
  processingNotes   String?  @map("processing_notes")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  hunt Hunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@map("hunt_denominations")
}

// Note: SQLite doesn't support enums, so we use string validation in the application layer
// Valid denomination types: 'Dimes', 'Quarters', 'Halves'
