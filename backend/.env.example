# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/silveredge?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL="http://localhost:8081"

# Railway Configuration (for production)
# DATABASE_URL will be automatically provided by Railway PostgreSQL service
# PORT will be automatically provided by Railway

# Security Configuration
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN="http://localhost:8081,exp://localhost:8081"
