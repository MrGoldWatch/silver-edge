# Environment Configuration Template
# Copy this to .env and fill in your values

# Application Environment
NODE_ENV=development  # development | production | staging

# Database Configuration
# Development (Railway dev environment)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# Production (Railway production environment)
# DATABASE_URL="postgresql://postgres:PROD_PASSWORD@PROD_HOST:PROD_PORT/railway"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
FRONTEND_URL="http://localhost:8081"  # development
# FRONTEND_URL="https://your-app-domain.com"  # production

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN="http://localhost:8081,exp://localhost:8081"  # development
# CORS_ORIGIN="https://your-app-domain.com"  # production

# Railway Project IDs (for reference)
# DEV_PROJECT_ID="4b38ca53-0032-446a-93bb-1d48eb303d9b"
# DEV_ENVIRONMENT_ID="eab8a112-f090-42a6-95b2-961633e1e765"
# DEV_SERVICE_ID="b6822324-c844-41b0-9969-0d134f12c82b"

# PROD_PROJECT_ID=""
# PROD_ENVIRONMENT_ID=""
# PROD_SERVICE_ID=""
