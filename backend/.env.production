# Production Environment Configuration
NODE_ENV=production

# Railway Production Database
DATABASE_URL="postgresql://postgres:JUuDJRfAYYPFurSmdZIRSisMDFdemFXT@mainline.proxy.rlwy.net:29507/railway"

# Production JWT Secret (MUST be different and secure)
# JWT_SECRET="production-super-secure-jwt-secret-minimum-32-characters-long"

# Production Server (Railway will provide PORT automatically)
# PORT will be set by Railway
# FRONTEND_URL="https://your-app-domain.com"

# Production Security
BCRYPT_ROUNDS=14  # Higher for production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50  # Stricter for production

# Production CORS (restrict to your app domain)
# CORS_ORIGIN="https://your-app-domain.com"

# Railway Production IDs (to be filled when created)
# PROD_PROJECT_ID=""
# PROD_ENVIRONMENT_ID=""
# PROD_SERVICE_ID=""

# Production Logging
LOG_LEVEL=error  # Less verbose logging in production
